{
  "name": "2026-04-21-files-mentioned-by-the-user-camscanner",
  "version": "1.0.0",
  "description": "Professional Quote and Invoice Generator",
  "main": "electron-main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:assets",
    "build:assets": "node -e \"const fs=require('fs'); fs.copyFileSync('jspdf.umd.min.js', 'build/jspdf.umd.min.js'); fs.copyFileSync('page_bg.js', 'build/page_bg.js'); fs.copyFileSync('page_img_1.jpg', 'build/page_img_1.jpg');\"",
    "preview": "vite preview",
    "win:build": "npx electron-builder",
    "mac:build": "npx electron-builder --mac",
    "start": "electron .",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:add": "npx cap add android"
  },
  "author": "Linea Chiara Infissi",
  "build": {
    "appId": "com.lineachiara.infissi",
    "productName": "Editor Preventivo",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "files": [
      "build/**/*",
      "electron-main.js",
      "package.json"
    ]
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "electron": "28.0.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/share": "^6.0.4"
  }
}
